generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// 1. AUTENTICACIÓN (NextAuth v5 / Auth.js)
// ==========================================

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(TEACHER)
  password      String?

  // Auth.js Relations
  accounts Account[]
  sessions Session[]

  // Application Relations
  teacherProfile TeacherProfile?
  purchases      Purchase[]
  downloads      Download[] // Historial de descargas (gratis y pago)
  scans          NotationScan[]
  reviews        Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==========================================
// 2. PERFIL DE PROFESOR
// ==========================================

model TeacherProfile {
  id              String  @id @default(cuid())
  userId          String  @unique
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fideTitle       String?
  fideId          String?
  peakRating      Int?
  bio             String?
  stripeAccountId String?

  resources Resource[]
  sales     Sale[]
}

// ==========================================
// 3. RECURSOS EDUCATIVOS
// ==========================================

enum ChessCategory {
  OPENINGS
  TACTICS
  STRATEGY
  ENDGAMES
  LESSON_PLAN
}

enum ResourceType {
  PDF_LESSON
  PGN_FILE
  WORKSHEET
  BUNDLE
}

model Resource {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  description String
  category    ChessCategory
  type        ResourceType

  minElo Int @default(0)
  maxElo Int @default(2800)

  fileUrl     String
  previewUrl  String?
  hasHomework Boolean @default(true)

  price       Float   @default(0.0)
  isPublished Boolean @default(false)

  teacherId String
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id])

  purchases Purchase[]
  downloads Download[] // Relación añadida para rastrear descargas
  reviews   Review[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

// ==========================================
// 4. VENTAS Y DESCARGAS
// ==========================================

enum PurchaseStatus {
  PENDING
  COMPLETED
  REFUNDED
}

// Registro de cuando alguien compra un recurso
model Purchase {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id])
  resourceId String
  resource   Resource       @relation(fields: [resourceId], references: [id])
  amount     Float
  status     PurchaseStatus @default(COMPLETED)
  createdAt  DateTime       @default(now())

  sale Sale?
}

// Registro de todas las bajadas de archivos (Gratis o Pago)
model Download {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  pricePaid  Float    @default(0.0)
  isFree     Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([resourceId])
}

model Sale {
  id              String         @id @default(cuid())
  purchaseId      String         @unique
  purchase        Purchase       @relation(fields: [purchaseId], references: [id])
  teacherId       String
  teacher         TeacherProfile @relation(fields: [teacherId], references: [id])
  grossAmount     Float
  platformFee     Float
  teacherEarnings Float
  createdAt       DateTime       @default(now())
}

// ==========================================
// 5. ESCANEO DE PLANILLAS (OCR)
// ==========================================

enum ScanStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model NotationScan {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  imageUrl  String
  pgnResult String?
  analysis  String?
  status    ScanStatus @default(PROCESSING)
  createdAt DateTime   @default(now())
}

// ==========================================
// 6. VALORACIONES
// ==========================================

model Review {
  id         String   @id @default(cuid())
  rating     Int
  comment    String?
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id])
  createdAt  DateTime @default(now())
}
