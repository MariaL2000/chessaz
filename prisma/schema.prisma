generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// 1. AUTENTICACIÓN (NextAuth v5 / Auth.js)
// ==========================================

enum Role {
  TEACHER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(TEACHER)
  password      String?

  // Auth.js Relations
  accounts Account[]
  sessions Session[]

  // Application Relations
  teacherProfile TeacherProfile?
  purchases      Purchase[]
  downloads      Download[] // Historial de descargas (registrados)
  scans          NotationScan[]
  reviews        Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==========================================
// 2. PERFIL DE PROFESOR
// ==========================================

model TeacherProfile {
  id                      String  @id @default(cuid())
  userId                  String  @unique
  user                    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fideTitle               String?
  fideId                  String?
  peakRating              Int?
  bio                     String?
  stripeAccountId         String?
  paypalMerchantId        String?
  paypalBusinessName      String?
  paypalBusinessEmail     String?
  paypalOnboardingStatus  String  @default("NOT_CONNECTED")
  paypalTrackingId        String? @unique

  resources Resource[]
  sales     Sale[]
}

// ==========================================
// 3. RECURSOS EDUCATIVOS
// ==========================================

enum ChessCategory {
  OPENINGS
  TACTICS
  STRATEGY
  ENDGAMES
  LESSON_PLAN
}

enum ResourceType {
  PDF_LESSON
  PGN_FILE
  WORKSHEET
  BUNDLE
}

model Resource {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  description String
  category    ChessCategory
  type        ResourceType

  minElo Int @default(0)
  maxElo Int @default(2800)

  fileUrl     String
  previewUrl  String?
  hasHomework Boolean @default(true)

  price       Float   @default(0.0)
  isPublished Boolean @default(false)

  teacherId String
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id])

  purchases   Purchase[]
  downloads   Download[]
  reviews     Review[]
  guestAccess GuestAccess[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  REFUNDED
}

model Purchase {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id])
  resourceId      String
  resource        Resource       @relation(fields: [resourceId], references: [id])
  amount          Float
  status          PurchaseStatus @default(PENDING)
  paypalOrderId   String?        @unique
  paypalCaptureId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  sale Sale?
}

model Download {
  id         String   @id @default(cuid())
  userId     String? // Opcional para admitir invitados
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestEmail String? // Correo del invitado que realizó la descarga
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  pricePaid  Float    @default(0.0)
  isFree     Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([resourceId])
}

model GuestAccess {
  id         String   @id @default(cuid())
  email      String
  resourceId String
  token      String   @unique
  expiresAt  DateTime
  isUsed     Boolean  @default(false)
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([email, resourceId])
}

model Sale {
  id              String         @id @default(cuid())
  purchaseId      String         @unique
  purchase        Purchase       @relation(fields: [purchaseId], references: [id])
  teacherId       String
  teacher         TeacherProfile @relation(fields: [teacherId], references: [id])
  grossAmount     Float
  platformFee     Float
  teacherEarnings Float
  createdAt       DateTime       @default(now())
}

// ==========================================
// 5. ESCANEO DE PLANILLAS (OCR)
// ==========================================

enum ScanStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model NotationScan {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  imageUrl  String
  pgnResult String?
  analysis  String?
  status    ScanStatus @default(PROCESSING)
  createdAt DateTime   @default(now())
}

// ==========================================
// 6. VALORACIONES
// ==========================================

model Review {
  id         String   @id @default(cuid())
  rating     Int
  comment    String?
  userId     String? // Opcional para invitados
  user       User?    @relation(fields: [userId], references: [id])
  guestEmail String? // Correo del invitado que reseña
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id])
  createdAt  DateTime @default(now())
}
